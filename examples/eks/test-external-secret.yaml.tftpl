# Test for External Secrets: Secrets Manager "${secret_name}" -> Kubernetes Secret default/demo-db
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: demo-db
  namespace: default
spec:
  refreshInterval: 1h # re-read Secrets Manager every hour (picks up RDS password rotation)
  secretStoreRef:
    kind: ClusterSecretStore
    name: ${store_name}
  target:
    name: demo-db # the Kubernetes Secret ESO creates and owns
  dataFrom:
    - extract:
        key: ${secret_name} # every JSON key becomes a Secret key: username, password
